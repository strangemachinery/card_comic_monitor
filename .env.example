# Copy to .env and adjust. The CLI loads .env automatically.

# Postgres + TimescaleDB connection (matches docker-compose.yml).
DATABASE_URL=postgresql://ccm:ccm@localhost:5432/ccm

# Path to the watchlist file (see watchlist.example.yaml).
WATCHLIST_PATH=watchlist.yaml

# Comma-separated sources to run during `ccm snapshot`.
# `stub` needs no API key and is always safe for local development.
# `tcgapi` is the recommended default card source (free tier, no card).
ENABLED_SOURCES=stub

# --- Source credentials ---
# tcgapi.dev: free 100 req/day; covers Pokemon, One Piece, Dragon Ball, MTG...
# Get a free key at https://tcgapi.dev  (resolves cards by TCGplayer product id)
# TCGAPI_API_KEY=

# PriceCharting (opt-in): one token covers cards + comics + games, but API
# access needs their pricier "Legendary" tier. https://www.pricecharting.com/api-documentation
# PRICECHARTING_TOKEN=

# Comics (next): GoCollect Pro for CGC-graded FMV + census.
# GOCOLLECT_API_KEY=
# COMICVINE_API_KEY=
